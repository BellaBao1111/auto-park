# --- Telegram ---
# Create a bot via @BotFather on Telegram, paste the token here.
TELEGRAM_BOT_TOKEN=

# Message /start to your bot once, the bot will reply with your chat_id.
# Only this chat_id is allowed to schedule payments.
TELEGRAM_CHAT_ID=

# --- Parking defaults ---
# Used to auto-pick the right city when a zone number matches multiple locations.
PREFERRED_LOCATION=San Jose, CA
RECEIPT_EMAIL=you@example.com

# Daily run time (24h, local time)
RUN_HOUR=9
RUN_MINUTE=5

# --- Card info ---
# Stored here in plaintext on purpose per your choice - keep this file at
# permissions 600, never commit it, never put it in a synced/cloud folder.
CARD_NUMBER=
CARD_EXP=MM/YYYY
CARD_CVV=
CARD_ZIP=

# --- Safety switch ---
# Keep "false" until you've watched a full headed dry run succeed.
# When false, the automation fills everything and STOPS before the final
# "PAY $X.XX" click - no money moves.
LIVE_MODE=false

# Show the browser window instead of running headless (for testing selectors)
HEADLESS=true
